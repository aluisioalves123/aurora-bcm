    "cortex-debug.variableUseNaturalFormat": false,

    // Git Bash como terminal padrao deste projeto.
    //
    // Nao e preferencia: os Makefiles montam a lista de fontes com "find -name",
    // e o Windows tem um find.exe proprio que nao aceita -name. No PowerShell o
    // find errado ganha, a lista sai vazia, e o build morre com "undefined
    // reference to main" — um erro que nao tem nada a ver com a causa.
    "terminal.integrated.defaultProfile.windows": "Git Bash",
    "terminal.integrated.profiles.windows": {
        "Git Bash": {
            "path": "C:/Program Files/Git/bin/bash.exe",
            "args": ["--login", "-i"],
            "icon": "terminal-bash"
        }
    }
}
